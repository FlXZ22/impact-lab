{
  "name": "segnalami",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Report accessibility barriers in Milan by chat: text, voice or photo, with automatic location",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.ts",
    "dev": "node --env-file-if-exists=.env --watch server.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "express": "^5.1.0",
    "leaflet": "^1.9.4",
    "pg": "^8.23.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.3"
  }
}
