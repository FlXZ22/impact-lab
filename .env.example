# Copy to .env and fill in locally. Never commit real keys.

HOST=127.0.0.1
PORT=3000

# --- Assistant (optional) -------------------------------------------------
# Without a key, reports still save and the chat answers with a fixed confirmation.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# --- Routing / dispatch (optional) ----------------------------------------
# The segnalazioni_ai service, which names the public body responsible for a report.
# Without it, reports save exactly as before and the chat shows no "who handles this"
# card. Nothing is ever transmitted to an authority either way.
ROUTING_URL=http://127.0.0.1:8081

# --- Voice transcription (Groq Whisper) -----------------------------------
# Without a key the microphone button explains that transcription is off.
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# --- Storage --------------------------------------------------------------
# The single switch: local | postgres | supabase
STORAGE_DRIVER=local

# local (default): SQLite file + photos on disk. Paths are relative to the project.
# SQLITE_PATH=data/segnalami.db
# UPLOADS_DIR=data/uploads

# postgres: any PostgreSQL. Photos stay on disk (UPLOADS_DIR).
# supabase: Supabase Postgres + photos in Supabase Storage.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# DATABASE_CA_CERT=certs/supabase-ca.crt

# supabase only:
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_BUCKET=report-images
